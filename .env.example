# Copy to .env.local; never commit the configured file or paste secrets in chat.
# The offline demo needs no API key and never sends provider requests.
GEMINI_API_KEY=
GEMINI_PLANNING_MODEL=gemini-3.8-flash
GEMINI_SPEECH_MODEL=gemini-3.8-flash-tts
GEMINI_VOICE=Kore

# ElevenLabs account key is separate from voice IDs. Never commit an actual key.
ELEVENLABS_API_KEY=
# Telugu voices, verified by library metadata; add these shared voices to your account.
# Female: Madhavi - Clear & Natural Conversation
ELEVENLABS_VOICE_MADHAVI_ID=4XvBGCPMXWyVQa75dbZg
# Male: Bharadwaj - Profound Telugu Mythology
ELEVENLABS_VOICE_BHARADWAJ_ID=RoLT1qx7XJRXxWSIG5hS
# Built-in voice for free API tests; Telugu delivery uses eleven_v3.
ELEVENLABS_FREE_VOICE_ID=Xb7hH8MSUJpSbSDYk0k2
ELEVENLABS_FREE_VOICE_NAME=Alice

# Live requests fail closed unless you explicitly confirm the key belongs
# to a free-tier project with billing disabled. Code cannot inspect billing.
GEMINI_FREE_TIER_CONFIRMED=false

# User confirmed organization headcount <= 3 during this prototype session.
# Set true after confirming eligibility for your own installation.
REMOTION_FREE_LICENSE_CONFIRMED=false
