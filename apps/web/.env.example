# Copy to .env.local in this directory. Keep real values out of Git and chat.
# AUTH_SECRET must be a cryptographically random secret of at least 32 characters.
AUTH_SECRET=
AUTH_URL=http://127.0.0.1:3000

# Google OAuth client type: Web application. These are NOT Gemini API keys.
# Exact authorized redirect URI: http://127.0.0.1:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated exact Google account emails. Empty denies all sign-ins.
TEAM_ALLOWED_EMAILS=

# MongoDB Atlas or another development MongoDB. Use a dedicated app database.
# URL-encode special characters in the URI password. Never paste the URI in chat.
MONGODB_URI=
MONGODB_DB=videocraft_dev

# One stable shared application workspace; do not change after members join.
WORKSPACE_ID=10000000-0000-4000-8000-000000000001
WORKSPACE_NAME=VideoCraft team
