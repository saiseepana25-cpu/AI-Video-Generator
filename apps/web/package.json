{
  "name": "videocraft-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "auth:check": "node --env-file-if-exists=.env.local --import tsx scripts/check-auth.ts",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/database.ts migrate",
    "db:check": "node --env-file-if-exists=.env.local --import tsx scripts/database.ts check",
    "db:test": "tsx --test tests/*.integration.ts",
    "db:test:init": "tsx scripts/init-test-database.ts",
    "providers:check": "node --env-file-if-exists=.env.local --import tsx scripts/providers.ts check",
    "providers:probe": "node --env-file-if-exists=.env.local --import tsx scripts/providers.ts probe",
    "providers:policy": "node --env-file-if-exists=.env.local --import tsx scripts/provider-policy.ts",
    "planning": "node --env-file-if-exists=.env.local --import tsx scripts/planning.ts",
    "generation": "node --env-file-if-exists=.env.local --import tsx scripts/generation.ts",
    "storage": "node --env-file-if-exists=.env.local --import tsx scripts/storage.ts"
  },
  "dependencies": {
    "@auth/mongodb-adapter": "3.11.3",
    "@aws-sdk/client-s3": "3.1154.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/noto-sans-telugu": "5.3.0",
    "@fontsource/sora": "5.3.0",
    "mongodb": "6.21.0",
    "next": "16.4.2",
    "next-auth": "5.0.0-beta.32",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "4.23.15",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=22"
  }
}
