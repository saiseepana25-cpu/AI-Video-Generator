{
  "name": "videocraft-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "auth:check": "node --env-file-if-exists=.env.local --import tsx scripts/check-auth.ts"
  },
  "dependencies": {
    "@auth/mongodb-adapter": "3.11.3",
    "@fontsource/inter": "5.3.0",
    "@fontsource/noto-sans-telugu": "5.3.0",
    "@fontsource/sora": "5.3.0",
    "mongodb": "6.21.0",
    "next": "16.4.2",
    "next-auth": "5.0.0-beta.32",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "4.23.15",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=22"
  }
}
